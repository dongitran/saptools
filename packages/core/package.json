{
  "name": "@saptools/core",
  "version": "0.1.0",
  "description": "Internal shared code for the @saptools CLIs (self-update, package metadata, ~/.saptools paths). Private: bundled into each CLI at build time, never published.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test:unit": "vitest run --coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "commander": "^13.0.0",
    "vitest": "^3.0.0"
  }
}
